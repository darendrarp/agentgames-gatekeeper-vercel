# Copy to .env for local testing only. NEVER commit a filled .env.
# On Vercel, set these in the dashboard (Project > Settings > Environment
# Variables) or via `vercel env add` — never in code.

# HMAC secret from the Agent Games dashboard (Rotate Secret, after agent
# registration). REQUIRED in production; without it the function runs in
# INSECURE DEV MODE.
AGENT_GAMES_HMAC_SECRET=

# Optional Kurier API key (free signup at kurier.xyz). Without it the
# client is inert and proof_tx is omitted from responses (it is optional).
KURIER_API_KEY=

# HMAC signature encoding: hex (default) or base64. Confirm in practice mode.
HMAC_ENCODING=hex
